# Copy to .env and fill in.
# WARNING: do NOT put inline comments after a value on the same line.
#   BAD :  POSTGRES_PORT=5433  # dev port
#   GOOD:  POSTGRES_PORT=5433
# Some dotenv parsers swallow the comment into the value and you get a silent,
# very confusing type error at startup.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst
POSTGRES_DB=analyst

QDRANT_URL=http://localhost:6333

# LLM providers (ADR-002). LLM_PROVIDER is one of: ollama, groq, openrouter.
# Free Groq key (no card): https://console.groq.com
# Groq free-tier models (2026-09-12): openai/gpt-oss-120b, openai/gpt-oss-20b
# Their limit is TOKENS: 8K per minute, 200K per day.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

LOG_LEVEL=INFO
